# Copia este fichero como .env y ajusta los valores (.env NO se sube a Git).
# Lo usa docker compose; con docker run se puede pasar con --env-file .env

# Usuario de Docker Hub con el que se etiqueta la imagen
DOCKERHUB_USER=tu-usuario-dockerhub
# Versión de la aplicación (etiqueta de la imagen y valor de /health)
APP_VERSION=1.0.0
# Puerto del equipo anfitrión donde se publica la API
HOST_PORT=8000
# Nivel de log de uvicorn: critical | error | warning | info | debug | trace
LOG_LEVEL=info
# Cargar al arrancar los datos de ejemplo de la Práctica 1 (true/false)
CARGAR_DATOS_EJEMPLO=true
